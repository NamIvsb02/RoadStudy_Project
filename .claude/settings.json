{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma migrate status)",
      "Bash(npx prisma generate)",
      "Bash(npm run db:generate)",
      "Bash(npx prettier --check *)",
      "Bash(graphify query *)",
      "Bash(graphify explain *)",
      "Bash(graphify path *)",
      "Bash(graphify section *)",
      "Bash(graphify update .)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(npm run db:migrate *)",
      "Bash(npx prisma db seed *)",
      "Bash(npx prisma db push *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(gh pr create *)",
      "Read(**/.env)",
      "Edit(**/.env)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
