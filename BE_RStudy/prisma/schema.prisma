// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================
enum Role {
  STUDENT
  TEACHER
  ADMINISTRATOR
}

enum AccountStatus {
  HOAT_DONG
  BI_KHOA
  CHO_XAC_MINH
}

enum Gender {
  NAM
  NU
  KHAC
  KHONG_TIET_LO
}

enum ApprovalStatus {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
}

enum FunctionStatus {
  HOAT_DONG
  NGUNG_HOAT_DONG
}

enum CategoryStatus {
  HOAT_DONG
  AN
}

enum CourseStatus {
  BAN_NHAP
  CHO_DUYET
  DA_PHE_DUYET
  DANG_MO
  TAM_NGUNG
  DA_KET_THUC
}

enum RegistrationStatus {
  CHO_THANH_TOAN
  DA_THANH_TOAN
  HOAN_THANH
  HOAN_TIEN
}

enum DiscountStatus {
  HOAT_DONG
  TAM_NGUNG
  HET_HAN
}

enum PaymentMethod {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
  VI_DIEN_TU
  CONG_THANH_TOAN_KHAC
}

enum InvoiceStatus {
  CHO_THANH_TOAN
  DA_THANH_TOAN
  THAT_BAI
  DA_HUY
  HOAN_TIEN
}

enum ReviewStatus {
  CHO_DUYET
  HIEN_THI
  AN
  VI_PHAM
}

// Dùng chung cho Comment, Reply, ReviewResponse
enum ContentStatus {
  HIEN_THI
  AN
  VI_PHAM
}

enum ExamStatus {
  BAN_NHAP
  DA_PHE_DUYET
  DANG_MO
  TAM_NGUNG
}

enum AttemptStatus {
  DANG_LAM
  DA_NOP
  DA_CHAM
  HUY
}

enum SenderType {
  STUDENT
  AI
}

enum ReportStatus {
  CHO_XU_LY
  DANG_XU_LY
  DA_XU_LY
  TU_CHOI
}

// ================= NGƯỜI DÙNG & PHÂN QUYỀN =================
model Account {
  id           String        @id @default(uuid()) @db.VarChar(36)
  fullName     String        @db.VarChar(100)
  email        String        @unique @db.VarChar(254)
  passwordHash String        @db.VarChar(255)
  phoneNumber  String?       @db.VarChar(15)
  avatarUrl    String?       @db.VarChar(2048)
  role         Role
  status       AccountStatus @default(CHO_XAC_MINH)
  createdAt    DateTime      @default(now())

  student         Student?
  teacher         Teacher?
  administrator   Administrator?
  comments        Comment[]
  replies         Reply[]
  reviewResponses ReviewResponse[]
  reportsSent     ViolationReport[] @relation("ReportReporter")
  reportsReceived ViolationReport[] @relation("ReportReported")
  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
}

model Student {
  id          String    @id @default(uuid()) @db.VarChar(36)
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  address     String?   @db.VarChar(255)
  joinedAt    DateTime  @default(now())
  accountId   String    @unique @db.VarChar(36)

  account       Account              @relation(fields: [accountId], references: [id])
  registrations CourseRegistration[]
  invoices      Invoice[]
  reviews       Review[]
  attempts      ExamAttempt[]
  conversations AiConversation[]
  supportRequests SupportRequest[]
}

model Teacher {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  specialization     String         @db.VarChar(150)
  biography          String         @db.Text
  teachingExperience String         @db.Text
  approvalStatus     ApprovalStatus @default(CHO_DUYET)
  accountId          String         @unique @db.VarChar(36)

  account   Account    @relation(fields: [accountId], references: [id])
  courses   Course[]
  resources Resource[]
}

model Administrator {
  id        String  @id @default(uuid()) @db.VarChar(36)
  accountId String  @unique @db.VarChar(36)
  isLeader  Boolean @default(false)

  account     Account                @relation(fields: [accountId], references: [id])
  permissions PermissionAssignment[]
}

model SystemFunction {
  id           String         @id @default(uuid()) @db.VarChar(36)
  functionName String         @unique @db.VarChar(100)
  description  String         @db.VarChar(500)
  status       FunctionStatus @default(HOAT_DONG)

  permissions PermissionAssignment[]
}

model PermissionAssignment {
  id              String   @id @default(uuid()) @db.VarChar(36)
  administratorId String   @db.VarChar(36)
  functionId      String   @db.VarChar(36)
  grantedAt       DateTime @default(now())

  administrator Administrator  @relation(fields: [administratorId], references: [id])
  function      SystemFunction @relation(fields: [functionId], references: [id])

  @@unique([administratorId, functionId])
}

// ================= KHÓA HỌC =================
model Category {
  id           String         @id @default(uuid()) @db.VarChar(36)
  categoryName String         @db.VarChar(100)
  description  String?        @db.VarChar(500)
  status       CategoryStatus @default(HOAT_DONG)

  courses   Course[]
  resources Resource[]
}

model Course {
  id            String       @id @default(uuid()) @db.VarChar(36)
  courseName    String       @db.VarChar(200)
  description   String       @db.Text
  price         Decimal      @default(0) @db.Decimal(12, 2)
  coverImageUrl String?      @db.VarChar(2048)
  status        CourseStatus @default(BAN_NHAP)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  startDate     DateTime
  endDate       DateTime
  categoryId    String       @db.VarChar(36)
  teacherId     String       @db.VarChar(36)

  category        Category               @relation(fields: [categoryId], references: [id])
  teacher         Teacher                @relation(fields: [teacherId], references: [id])
  registrations   CourseRegistration[]
  reviews         Review[]
  comments        Comment[]
  exams           Exam[]
  recommendations CourseRecommendation[]

  @@index([categoryId])
  @@index([teacherId])
  @@index([status])
}

model Resource {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  resourceName        String   @db.VarChar(200)
  fileUrl             String   @db.VarChar(2048)
  createdAt           DateTime @default(now())
  uploadedByTeacherId String   @db.VarChar(36)
  categoryId          String   @db.VarChar(36) // SỬA: bản gốc ghi dở

  uploadedBy Teacher  @relation(fields: [uploadedByTeacherId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
}

// ================= ĐĂNG KÝ & THANH TOÁN =================
model CourseRegistration {
  id           String             @id @default(uuid()) @db.VarChar(36)
  registeredAt DateTime           @default(now())
  status       RegistrationStatus @default(CHO_THANH_TOAN)
  amountPaid   Decimal            @default(0) @db.Decimal(12, 2)
  studentId    String             @db.VarChar(36)
  courseId     String             @db.VarChar(36)

  student  Student   @relation(fields: [studentId], references: [id])
  course   Course    @relation(fields: [courseId], references: [id])
  invoices Invoice[]
  supportRequests SupportRequest[]

  @@unique([studentId, courseId]) // mỗi học viên chỉ đăng ký 1 lần/khóa (không cho hủy, không đăng ký lại)
}

model DiscountCode {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  code               String         @unique @db.VarChar(50)
  discountAmount     Decimal?       @db.Decimal(12, 2)
  discountPercentage Decimal?       @db.Decimal(5, 2) // THÊM MỚI: tài liệu có nhắc nhưng thiếu cột
  startDate          DateTime
  endDate            DateTime
  usageLimit         Int
  usedCount          Int            @default(0) // THÊM MỚI: đếm lượt đã dùng
  status             DiscountStatus @default(HOAT_DONG)

  invoices Invoice[]
}

model Invoice {
  id                    String        @id @default(uuid()) @db.VarChar(36)
  subtotal              Decimal       @db.Decimal(12, 2)
  discountAmountApplied Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal       @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  status                InvoiceStatus @default(CHO_THANH_TOAN)
  paidAt                DateTime?
  studentId             String        @db.VarChar(36)
  registrationId        String        @db.VarChar(36)
  discountCodeId        String?       @db.VarChar(36)

  student      Student            @relation(fields: [studentId], references: [id])
  registration CourseRegistration @relation(fields: [registrationId], references: [id])
  discountCode DiscountCode?      @relation(fields: [discountCodeId], references: [id])

  @@index([registrationId])
}

// ================= ĐÁNH GIÁ & BÌNH LUẬN =================
model Review {
  id         String       @id @default(uuid()) @db.VarChar(36)
  rating     Int          @db.SmallInt
  content    String?      @db.Text
  reviewedAt DateTime     @default(now())
  status     ReviewStatus @default(CHO_DUYET)
  studentId  String       @db.VarChar(36)
  courseId   String       @db.VarChar(36)

  student   Student           @relation(fields: [studentId], references: [id])
  course    Course            @relation(fields: [courseId], references: [id])
  responses ReviewResponse[]
  reports   ViolationReport[]

  @@unique([studentId, courseId]) // mỗi học viên đánh giá 1 lần/khóa (bỏ dòng này nếu muốn cho đánh giá nhiều lần)
  @@index([courseId])
}

model Comment {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  content            String        @db.Text
  commentedAt        DateTime      @default(now())
  status             ContentStatus @default(HIEN_THI)
  commenterAccountId String        @db.VarChar(36)
  courseId           String        @db.VarChar(36)

  commenter Account           @relation(fields: [commenterAccountId], references: [id])
  course    Course            @relation(fields: [courseId], references: [id])
  replies   Reply[]
  reports   ViolationReport[]

  @@index([courseId])
}

model Reply {
  id               String        @id @default(uuid()) @db.VarChar(36)
  content          String        @db.Text
  repliedAt        DateTime      @default(now())
  status           ContentStatus @default(HIEN_THI)
  commentId        String        @db.VarChar(36)
  replierAccountId String        @db.VarChar(36)

  comment Comment           @relation(fields: [commentId], references: [id])
  replier Account           @relation(fields: [replierAccountId], references: [id])
  reports ViolationReport[]
}

model ReviewResponse {
  id          String        @id @default(uuid()) @db.VarChar(36)
  content     String        @db.Text
  respondedAt DateTime      @default(now())
  status      ContentStatus @default(HIEN_THI)
  reviewId    String        @db.VarChar(36)
  accountId   String        @db.VarChar(36)

  review  Review  @relation(fields: [reviewId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

// ================= THI =================
model Exam {
  id              String     @id @default(uuid()) @db.VarChar(36)
  examName        String     @db.VarChar(200)
  durationMinutes Int
  passingScore    Decimal    @db.Decimal(5, 2)
  status          ExamStatus @default(BAN_NHAP)
  createdAt       DateTime   @default(now())
  courseId        String     @db.VarChar(36)

  course    Course         @relation(fields: [courseId], references: [id])
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([courseId])
}

model ExamQuestion {
  id            String  @id @default(uuid()) @db.VarChar(36)
  content       String  @db.Text
  score         Decimal @db.Decimal(5, 2)
  questionOrder Int
  examId        String  @db.VarChar(36)

  exam           Exam                @relation(fields: [examId], references: [id])
  options        AnswerOption[]
  attemptDetails ExamAttemptDetail[]

  @@index([examId])
}

model AnswerOption {
  id         String  @id @default(uuid()) @db.VarChar(36)
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  questionId String  @db.VarChar(36)

  question       ExamQuestion        @relation(fields: [questionId], references: [id])
  attemptDetails ExamAttemptDetail[]

  @@index([questionId])
}

model ExamAttempt {
  id        String        @id @default(uuid()) @db.VarChar(36)
  score     Decimal?      @db.Decimal(5, 2)
  startTime DateTime      @default(now())
  endTime   DateTime?
  status    AttemptStatus @default(DANG_LAM)
  studentId String        @db.VarChar(36)
  examId    String        @db.VarChar(36)

  student Student             @relation(fields: [studentId], references: [id])
  exam    Exam                @relation(fields: [examId], references: [id])
  details ExamAttemptDetail[]

  @@index([studentId, examId])
}

model ExamAttemptDetail {
  id             String  @id @default(uuid()) @db.VarChar(36)
  attemptId      String  @db.VarChar(36)
  questionId     String  @db.VarChar(36)
  answerOptionId String? @db.VarChar(36)

  attempt      ExamAttempt   @relation(fields: [attemptId], references: [id])
  question     ExamQuestion  @relation(fields: [questionId], references: [id])
  answerOption AnswerOption? @relation(fields: [answerOptionId], references: [id])

  @@unique([attemptId, questionId])
}

// ================= AI =================
model AiConversation {
  id        String    @id @default(uuid()) @db.VarChar(36)
  startTime DateTime  @default(now())
  endTime   DateTime?
  studentId String    @db.VarChar(36)

  student  Student     @relation(fields: [studentId], references: [id])
  messages AiMessage[]
}

model AiMessage {
  id             String     @id @default(uuid()) @db.VarChar(36)
  senderType     SenderType
  content        String     @db.Text
  sentAt         DateTime   @default(now())
  conversationId String     @db.VarChar(36)

  conversation    AiConversation         @relation(fields: [conversationId], references: [id])
  recommendations CourseRecommendation[]

  @@index([conversationId])
}

model CourseRecommendation {
  id                   String  @id @default(uuid()) @db.VarChar(36)
  recommendationReason String? @db.Text
  messageId            String  @db.VarChar(36)
  courseId             String  @db.VarChar(36)

  message AiMessage @relation(fields: [messageId], references: [id])
  course  Course    @relation(fields: [courseId], references: [id])
}

// ================= BÁO CÁO VI PHẠM =================
model ViolationReport {
  id                String       @id @default(uuid()) @db.VarChar(36)
  content           String       @db.Text
  reason            String       @db.VarChar(500)
  reportedAt        DateTime     @default(now())
  status            ReportStatus @default(CHO_XU_LY)
  resolutionResult  String?      @db.Text
  reporterAccountId String       @db.VarChar(36)
  reportedAccountId String?      @db.VarChar(36)
  reviewId          String?      @db.VarChar(36)
  commentId         String?      @db.VarChar(36)
  replyId           String?      @db.VarChar(36)

  reporter        Account  @relation("ReportReporter", fields: [reporterAccountId], references: [id])
  reportedAccount Account? @relation("ReportReported", fields: [reportedAccountId], references: [id])
  review          Review?  @relation(fields: [reviewId], references: [id])
  comment         Comment? @relation(fields: [commentId], references: [id])
  reply           Reply?   @relation(fields: [replyId], references: [id])
}

enum SupportRequestType {
  HOAN_TIEN_KHOA_HOC
}

enum SupportRequestStatus {
  CHO_XU_LY
  DA_XU_LY
  TU_CHOI
}

model SupportRequest {
  id             String               @id @default(uuid()) @db.VarChar(36)
  type           SupportRequestType
  description    String               @db.Text
  status         SupportRequestStatus @default(CHO_XU_LY)
  adminNote      String?              @db.Text
  createdAt      DateTime             @default(now())
  handledAt      DateTime?
  studentId      String               @db.VarChar(36)
  registrationId String               @db.VarChar(36)

  student      Student            @relation(fields: [studentId], references: [id])
  registration CourseRegistration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
}

enum OtpPurpose {
  XAC_MINH_EMAIL
  QUEN_MAT_KHAU
}

model OtpCode {
  id         String     @id @default(uuid()) @db.VarChar(36)
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  accountId  String     @db.VarChar(36)

  account Account @relation(fields: [accountId], references: [id])
  attempts   Int        @default(0)

  @@index([accountId, purpose])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(64) // sha256 hex = 64 ký tự
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  accountId String    @db.VarChar(36)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
}