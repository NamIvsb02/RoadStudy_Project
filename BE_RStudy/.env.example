PORT=5000
# Số lớp reverse proxy phía trước (nginx...). 0 = chạy trực tiếp. Cần đúng để rate limit lấy đúng IP
TRUST_PROXY=0
NODE_ENV=development

# Supabase: app dùng chuỗi qua pooler, Prisma CLI (migrate/seed) dùng chuỗi kết nối trực tiếp. Nam cấp cả hai.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET
JWT_REFRESH_EXPIRES=7d

OTP_EXPIRES_MINUTES=10

PAYMENT_BANK_ID=ma_ngan_hang_nhan_chuyen_khoan_theo_VietQR
PAYMENT_ACCOUNT_NO=stk_ngan_hang_nhan_chuyen_khoan
PAYMENT_ACCOUNT_NAME=ten_chu_tai_khoan_nhan_chuyen_khoan

# AI_PROVIDER=gemini dùng GEMINI_*; AI_PROVIDER=openai dùng AI_* (mọi API tương thích OpenAI, mặc định Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=20000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD
MAIL_FROM="RoadStudy <roadstudy.noreply@gmail.com>"
